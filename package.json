{
  "name": "app-clima-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src eslint.config.js vite.config.ts vitest.contract.config.ts scripts/open-meteo-performance.mjs",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:performance": "node scripts/open-meteo-performance.mjs",
    "qa:test": "playwright test --config=qa/playwright.config.ts",
    "qa:test:ejemplo": "playwright test --config=qa/playwright.config.ts --project=ejemplo",
    "qa:test:jc": "playwright test --config=qa/playwright.config.ts --project=jc",
    "qa:test:js": "playwright test --config=qa/playwright.config.ts --project=js",
    "qa:test:ss": "playwright test --config=qa/playwright.config.ts --project=ss",
    "qa:validate-results": "node scripts/validate-qa-results.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "newman": "^6.2.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
